# DB
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_URL=postgresql+asyncpg://your_database_user:your_database_password@localhost:5432/your_database_name

BACKEND_PORT=8000

# CORS: JSON-массив источников, "*" разрешает любые (по умолчанию).
# Credentials отключены, т.к. API использует Bearer-токены.
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# CORS_ALLOW_CREDENTIALS=false

# Максимум откликов на исполнителя за скользящие 24 часа
# MAX_PROPOSALS_PER_DAY=3

# Время жизни токенов
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate limiting (in-memory, действует в пределах одного процесса)
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_WINDOW_SECONDS=60
# REGISTER_RATE_LIMIT=5
# REGISTER_RATE_WINDOW_SECONDS=3600

# Секрет подписи JWT: минимум 32 символа, дефолтные значения запрещены.
# Сгенерировать: openssl rand -hex 32
JWT_SECRET_KEY=change-me-use-a-random-64-character-secret-value
